generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TournamentFormat {
  MINICUP
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum RoundStatus {
  PENDING
  SEATING_READY
  IN_PROGRESS
  SCORING
  COMPLETED
}

enum GameStatus {
  PENDING
  IN_PROGRESS
  SCORING
  COMPLETED
}

enum TournamentScoringStatus {
  ACTIVE
  READY_TO_FINALIZE
  REQUIRES_MANUAL_DECISION
  REQUIRES_DRAW_LOT
  NEEDS_RECALCULATION
  FINALIZED
}

enum RankingStatus {
  PROVISIONAL
  REQUIRES_DRAW_LOT
  FINAL
}

enum SeatingStatus {
  PENDING
  GENERATED
  CONFIRMED
}

enum GamePhase {
  SETUP
  ROLE_ASSIGNMENT
  NIGHT
  DAY
  VOTING
  CAR_CRASH
  FINAL_SPEECH
  PROTOCOL
  RESULT_CONFIRMATION
  SCORING
}

enum GameSubphase {
  SETUP
  ROLE_ASSIGNMENT
  AGREEMENT
  FREE_SEATING
  SPEECH
  PRIMARY
  CRASH_SPEECH
  REVOTE
  GROUP_EXIT
  SHOOTING
  DON_CHECK
  SHERIFF_CHECK
  BLACK_TRIPLE
  FINAL_SPEECH
  PROTOCOL
  RESULT_CONFIRMATION
  SCORING
}

enum GameWinner {
  RED
  BLACK
  DRAW
}

enum PlayerRole {
  CIVILIAN
  SHERIFF
  MAFIA
  DON
}

enum PlayerTeam {
  RED
  BLACK
}

enum GameSeatStatus {
  ACTIVE
  ELIMINATED
}

enum EliminationReason {
  VOTE
  SHOT
  FOURTH_FOUL
  MANUAL
}

enum NominationStatus {
  ACTIVE
  UNDONE
}

enum VoteSessionType {
  PRIMARY
  REVOTE
  GROUP_EXIT
}

enum VoteSessionStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum NightActionType {
  SHOT
  DON_CHECK
  SHERIFF_CHECK
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  tournaments Tournament[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Tournament {
  id                   String                  @id @default(uuid())
  organizationId       String
  organization         Organization            @relation(fields: [organizationId], references: [id])
  name                 String
  format               TournamentFormat        @default(MINICUP)
  status               TournamentStatus        @default(DRAFT)
  roundCount           Int                     @default(5)
  compensationDistance Int                     @default(5)
  scoringStatus        TournamentScoringStatus @default(ACTIVE)
  finalizedAt          DateTime?
  players              TournamentPlayer[]
  rounds               Round[]
  scores               TournamentScore[]
  events               TournamentEvent[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([organizationId])
}

model Player {
  id                String             @id @default(uuid())
  nickname          String
  tournamentEntries TournamentPlayer[]
  seats             GameSeat[]
  gameScores        GameScore[]
  tournamentScores  TournamentScore[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model TournamentPlayer {
  id                 String     @id @default(uuid())
  tournamentId       String
  playerId           String
  nicknameNormalized String
  registrationOrder  Int
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player             Player     @relation(fields: [playerId], references: [id])
  createdAt          DateTime   @default(now())

  @@unique([tournamentId, playerId])
  @@unique([tournamentId, nicknameNormalized])
  @@unique([tournamentId, registrationOrder])
}

model Round {
  id           String      @id @default(uuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int
  status       RoundStatus @default(PENDING)
  game         Game?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([tournamentId, number])
}

model Game {
  id                    String        @id @default(uuid())
  roundId               String        @unique
  round                 Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  status                GameStatus    @default(PENDING)
  seatingStatus         SeatingStatus @default(PENDING)
  phase                 GamePhase     @default(SETUP)
  subphase              GameSubphase  @default(SETUP)
  dayNumber             Int           @default(0)
  nightNumber           Int           @default(0)
  firstSpeakerSeat      Int?
  currentSpeakerSeat    Int?
  quietPhaseCount       Int           @default(0)
  firstDayVoteExitCount Int           @default(0)
  pendingExitSeats      Int[]         @default([])
  exitResume            String?
  winner                GameWinner?
  pendingWinner         GameWinner?
  startedAt             DateTime?
  finishedAt            DateTime?
  seats                 GameSeat[]
  nominations           Nomination[]
  voteSessions          VoteSession[]
  nightActions          NightAction[]
  blackTriple           BlackTriple?
  penalties             Penalty[]
  events                GameEvent[]
  scores                GameScore[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model GameSeat {
  id                       String             @id @default(uuid())
  gameId                   String
  playerId                 String
  seatNumber               Int
  role                     PlayerRole?
  team                     PlayerTeam?
  status                   GameSeatStatus     @default(ACTIVE)
  eliminationReason        EliminationReason?
  foulCount                Int                @default(0)
  speechRestrictionPending Boolean            @default(false)
  game                     Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player                   Player             @relation(fields: [playerId], references: [id])
  blackTriples             BlackTriple[]
  penalties                Penalty[]
  score                    GameScore?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@unique([gameId, playerId])
  @@unique([gameId, seatNumber])
}

model Nomination {
  id            String           @id @default(uuid())
  gameId        String
  dayNumber     Int
  nominatorSeat Int
  nomineeSeat   Int
  order         Int
  status        NominationStatus @default(ACTIVE)
  game          Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([gameId, dayNumber, status])
}

model VoteSession {
  id             String            @id @default(uuid())
  gameId         String
  dayNumber      Int
  type           VoteSessionType
  sequence       Int
  candidateSeats Int[]
  tieSeats       Int[]             @default([])
  status         VoteSessionStatus @default(OPEN)
  game           Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  results        VoteResult[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([gameId, sequence])
}

model VoteResult {
  id            String      @id @default(uuid())
  voteSessionId String
  nomineeSeat   Int
  votes         Int
  voteSession   VoteSession @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([voteSessionId, nomineeSeat])
}

model NightAction {
  id          String          @id @default(uuid())
  gameId      String
  nightNumber Int
  type        NightActionType
  targetSeat  Int?
  result      String
  undoneAt    DateTime?
  game        Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@index([gameId, nightNumber, type])
}

model BlackTriple {
  id                    String   @id @default(uuid())
  gameId                String   @unique
  firstKilledGameSeatId String
  selectedSeats         Int[]
  correctBlackCount     Int
  calculatedPoints      Decimal  @db.Decimal(4, 2)
  game                  Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  firstKilledGameSeat   GameSeat @relation(fields: [firstKilledGameSeatId], references: [id])
  createdAt             DateTime @default(now())
}

model Penalty {
  id         String    @id @default(uuid())
  gameId     String
  gameSeatId String
  value      Decimal   @db.Decimal(5, 2)
  type       String
  comment    String?
  isOverride Boolean   @default(false)
  undoneAt   DateTime?
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameSeat   GameSeat  @relation(fields: [gameSeatId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([gameId, gameSeatId])
}

model GameEvent {
  id             String   @id @default(uuid())
  gameId         String
  type           String
  payload        Json
  overrideReason String?
  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([gameId, createdAt])
}

model GameScore {
  id                       String   @id @default(uuid())
  gameId                   String
  gameSeatId               String   @unique
  playerId                 String
  basePoints               Decimal  @db.Decimal(7, 3)
  judgeAdditionalPoints    Decimal  @default(0) @db.Decimal(7, 3)
  blackTriplePoints        Decimal  @default(0) @db.Decimal(7, 3)
  penaltyPoints            Decimal  @default(0) @db.Decimal(7, 3)
  compensationPoints       Decimal  @default(0) @db.Decimal(7, 3)
  manualCompensationPoints Decimal? @db.Decimal(7, 3)
  totalWithoutCompensation Decimal  @db.Decimal(7, 3)
  finalTotal               Decimal  @db.Decimal(7, 3)
  headJudgeApproved        Boolean  @default(false)
  isLocked                 Boolean  @default(false)
  game                     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameSeat                 GameSeat @relation(fields: [gameSeatId], references: [id], onDelete: Restrict)
  player                   Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([gameId, playerId])
  @@index([gameId])
}

model TournamentScore {
  id                           String        @id @default(uuid())
  tournamentId                 String
  playerId                     String
  baseTotal                    Decimal       @db.Decimal(8, 3)
  judgeAdditionalTotal         Decimal       @db.Decimal(8, 3)
  blackTripleTotal             Decimal       @db.Decimal(8, 3)
  penaltyTotal                 Decimal       @db.Decimal(8, 3)
  compensationTotal            Decimal       @db.Decimal(8, 3)
  total                        Decimal       @db.Decimal(8, 3)
  wins                         Int
  gamesPlayed                  Int
  firstNightKillsCount         Int
  successfulTriple3Count       Int
  successfulTriple2Count       Int
  maxNetJudgeAdditionalPerGame Decimal       @db.Decimal(8, 3)
  finalRank                    Int?
  rankingStatus                RankingStatus @default(PROVISIONAL)
  drawLotOrder                 Int?
  tournament                   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player                       Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  @@unique([tournamentId, playerId])
  @@index([tournamentId, finalRank])
}

model TournamentEvent {
  id             String     @id @default(uuid())
  tournamentId   String
  type           String
  payload        Json
  overrideReason String?
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@index([tournamentId, createdAt])
}
