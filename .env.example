# Production Docker Compose. Replace every placeholder before deployment.
POSTGRES_DB=mafia_judge
POSTGRES_USER=mafia_judge
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://mafia_judge:replace-with-a-long-random-password@db:5432/mafia_judge?schema=public

# Domain without protocol; DNS A/AAAA record must point to the VPS.
DOMAIN=mafia.example.com
NEXT_PUBLIC_APP_URL=https://mafia.example.com

# One-time SUPER_ADMIN bootstrap. Prefer passing these only to
# `npm run admin:create`; do not keep ADMIN_PASSWORD in production env.
ADMIN_LOGIN=admin
ADMIN_DISPLAY_NAME=Главный администратор
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Optional operational settings.
TZ=Europe/Moscow
